// =============================================================================
// ERP-MARKET - SCHEMA COMPLETO (Prisma 7.x + Supabase)
// Login by username + Venezuela cedula (V/E)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  OWNER
  SELLER
}

enum TransactionType {
  SALE
  INVENTORY_IN
  QUOTE
}

enum TransactionStatus {
  COMPLETED
  CANCELLED
  PENDING
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum CedulaType {
  V
  E
}

enum MermaReason {
  DAMAGED
  EXPIRED
  SOBRANTE
  BAD_CONDITION
  OTHER
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// =============================================================================
// USERS (AUTH)
// =============================================================================

model User {
  id         String     @id @default(cuid())
  username   String     @unique
  cedula     String
  cedulaType CedulaType @default(V)
  nombre     String
  apellido   String?
  email      String?
  password   String
  telefono   String?
  role       Role       @default(SELLER)
  canManageInventory Boolean @default(false)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now()) @db.Timestamptz
  updatedAt  DateTime   @updatedAt @db.Timestamptz

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

transactions  Transaction[]
cashRegisters CashRegister[]
auditLogs     AuditLog[]
mermas        Merma[] @relation("MermaCreatedBy")
stockCounts   StockCount[]

@@index([username])
  @@index([cedula])
  @@index([role])
  @@index([isActive])
  @@index([branchId])
  @@map("users")
}

// =============================================================================
// BRANCHES
// =============================================================================

model Branch {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique // Ej: 'V-01', 'CCS-02'
  address   String?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt     @db.Timestamptz

  users          User[]
  inventory      BranchInventory[]
  transactions   Transaction[]
  cashRegisters  CashRegister[]
  purchaseOrders PurchaseOrder[]
  mermas         Merma[]
  stockCounts    StockCount[]
  productBatches ProductBatch[]

  @@index([isActive])
  @@map("branches")
}

// =============================================================================
// GROUPS
// =============================================================================

model Group {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  subGroups SubGroup[]

  @@index([isActive])
  @@map("groups")
}

model SubGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  groupId String
  group   Group   @relation(fields: [groupId], references: [id])

  products Product[]

  @@unique([name, groupId])
  @@index([groupId])
  @@index([isActive])
  @@map("sub_groups")
}

// =============================================================================
// PRODUCTS
// =============================================================================

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// @deprecated — usar barcodes relation
  barcode     String?  @unique
  price       Decimal  @db.Decimal(12, 2) // en COP (moneda principal)
  cost        Decimal? @db.Decimal(12, 2) // en COP (moneda principal)
  baseUnit    String   @default("UNIDAD")
imageUrl    String?
  isActive    Boolean  @default(true)
  expectedSpoilagePercent Decimal? @db.Decimal(5, 2) // % merma esperada (ej: 5.00 = 5%)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  subGroupId String?
  subGroup   SubGroup? @relation(fields: [subGroupId], references: [id])

  barcodes           ProductBarcode[]
  presentations      ProductPresentation[]
  inventory          BranchInventory[]
  transactionItems   TransactionItem[]
  purchaseOrderItems PurchaseOrderItem[]
  mermas             Merma[]
  stockCountItems    StockCountItem[]
  productBatches     ProductBatch[]
  // Kits: componentes que componen este producto (padre)
  kitComponents KitComponent[] @relation("KitComponents")
  // Kits: kits de los cuales este producto es componente
  partOfKits   KitComponent[] @relation("KitMemberOf")

  @@index([name])
  @@index([subGroupId])
  @@index([isActive])
  @@index([barcode])
  @@map("products")
}

// =============================================================================
// KITS — Producto compuesto por otros productos
// El kit se vende a su propio precio; el stock se valida/descuenta por componente.
// =============================================================================

model KitComponent {
  id                 String  @id @default(cuid())
  kitProductId       String
  kitProduct         Product @relation("KitComponents", fields: [kitProductId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct   Product @relation("KitMemberOf", fields: [componentProductId], references: [id])
  quantity           Decimal @db.Decimal(12, 3) // cantidad del componente por kit
  createdAt          DateTime @default(now()) @db.Timestamptz

  @@unique([kitProductId, componentProductId])
  @@index([componentProductId])
  @@map("kit_components")
}

model ProductPresentation {
  id         String  @id @default(cuid())
  name       String
  multiplier Decimal @db.Decimal(12, 3)
  price      Decimal @db.Decimal(12, 2) // en COP (moneda principal)
  barcode    String? @unique

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  transactionItems TransactionItem[]

  @@index([productId])
  @@index([barcode])
  @@map("product_presentations")
}

// Múltiples códigos de barras por producto (EAN, interno, proveedor, etc.)
model ProductBarcode {
  id    String  @id @default(cuid())
  code  String  @unique
  label String? // Ej: "EAN-13", "Interno", "Proveedor"

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([code])
  @@map("product_barcodes")
}

// =============================================================================
// INVENTORY BY BRANCH
// =============================================================================

model BranchInventory {
  id        String   @id @default(cuid())
  stock     Decimal  @default(0) @db.Decimal(12, 3)
  minStock  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt @db.Timestamptz

  productId String
  product   Product @relation(fields: [productId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
  @@index([branchId])
  @@index([stock])
  @@index([branchId, stock])
  @@map("branch_inventory")
}

// =============================================================================
// TRANSACTIONS
// =============================================================================

model Transaction {
  id             String            @id @default(cuid())
  type           TransactionType
  status         TransactionStatus @default(COMPLETED)
  total          Decimal           @db.Decimal(12, 2) // siempre en COP
  notes          String?
  ipAddress      String?
  syncStatus     SyncStatus        @default(PENDING)
  syncedAt       DateTime?         @db.Timestamptz
  createdAt      DateTime          @default(now()) @db.Timestamptz
  updatedAt      DateTime          @updatedAt @db.Timestamptz

  // Multi-moneda
  currency       String?           // 'COP' | 'USD' | 'VES' — moneda en la que se realizó
  exchangeRate   Decimal?          @db.Decimal(18, 4) // tasa COP/currency usada al momento
  invoiceNumber  String?           // Nº factura (para INVENTORY_IN)

  // Multi-pago
  paymentMethods Json?             // [{ type: "cash", amount: 5000, currency: "COP" }, ...]

  // Metadata flexible (F4 Cotizaciones)
  // QUOTE: { type: "quote", quoteConvertedTo: <saleId> }
  // SALE:  { quoteSource: <quoteId> }
  metadata Json?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])

  // Fiados / CxC: cliente asociado a ventas a crédito
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  items    TransactionItem[]
  payments CustomerPayment[]

  @@index([branchId, createdAt])
  @@index([userId])
  @@index([cashRegisterId])
  @@index([type, status])
  @@index([syncStatus])
  @@index([createdAt])
  @@index([customerId])
  @@map("transactions")
}

model TransactionItem {
  id             String  @id @default(cuid())
  quantity       Decimal @db.Decimal(12, 3)
  multiplierUsed Decimal @default(1) @db.Decimal(12, 3)
  unitPrice      Decimal @db.Decimal(12, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  presentationId String?
  presentation   ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@index([productId])
  @@index([presentationId])
  @@map("transaction_items")
}

// =============================================================================
// CASH REGISTER
// =============================================================================

model CashRegister {
  id             String             @id @default(cuid())
  status         CashRegisterStatus @default(OPEN)
  openingAmount  Decimal            @db.Decimal(12, 2)
  closingAmount  Decimal?           @db.Decimal(12, 2)
  expectedAmount Decimal?           @db.Decimal(12, 2)
  difference     Decimal?           @db.Decimal(12, 2)
  notes          String?
  syncStatus     SyncStatus         @default(PENDING)
  syncedAt       DateTime?          @db.Timestamptz
  openedAt       DateTime           @default(now()) @db.Timestamptz
  closedAt       DateTime?          @db.Timestamptz

  userId String
  user   User   @relation(fields: [userId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  transactions Transaction[]

  @@index([branchId])
  @@index([userId])
  @@index([status])
  @@index([syncStatus])
  @@index([branchId, status])
  @@map("cash_registers")
}

// =============================================================================
// AUDIT LOGS
// =============================================================================

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  module    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================================================
// SUPPLIERS
// =============================================================================

model Supplier {
  id        String   @id @default(cuid())
  name      String
  rut       String?  @unique
  email     String?
  telefono  String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

// =============================================================================
// CUSTOMERS (Fiados / CxC)
// =============================================================================

model Customer {
  id          String   @id @default(cuid())
  name        String
  cedula      String?  @unique // Cédula/RIF del cliente (V/E)
  phone       String?
  email       String?
  address     String?
  creditLimit Decimal? @db.Decimal(12, 2) // Límite de crédito (null = sin límite)
  balance     Decimal  @default(0) @db.Decimal(12, 2) // Saldo pendiente por cobrar
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  transactions Transaction[]
  payments     CustomerPayment[]

  @@index([name])
  @@index([cedula])
  @@index([isActive])
  @@map("customers")
}

model CustomerPayment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2) // Monto del abono
  method    String   @default("cash") // 'cash' | 'transfer' | 'card' | 'other'
  reference String?  // Referencia del pago (ej: nro de transferencia)
  notes     String?
  createdAt DateTime @default(now()) @db.Timestamptz

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  transactionId String? // Venta a crédito que se está abonando (opcional)
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([customerId])
  @@index([transactionId])
  @@index([createdAt])
  @@map("customer_payments")
}

// =============================================================================
// PURCHASE ORDERS
// =============================================================================

model PurchaseOrder {
  id         String              @id @default(cuid())
  status     PurchaseOrderStatus @default(DRAFT)
  total      Decimal             @db.Decimal(12, 2)
  // CxP (F7): monto ya pagado al proveedor y fecha límite de pago
  paidAmount Decimal             @default(0) @db.Decimal(12, 2)
  dueDate    DateTime?           @db.Timestamptz
  notes      String?
  expectedAt DateTime?           @db.Timestamptz
  receivedAt DateTime?           @db.Timestamptz
  createdAt  DateTime            @default(now()) @db.Timestamptz
  updatedAt  DateTime            @updatedAt @db.Timestamptz

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  items    PurchaseOrderItem[]
  payments SupplierPayment[]

  @@index([supplierId])
  @@index([branchId])
  @@map("purchase_orders")
}

model SupplierPayment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2) // Monto del pago al proveedor
  method    String   @default("cash") // 'cash' | 'transfer' | 'card' | 'other'
  reference String?  // Referencia del pago (ej: nro de transferencia)
  notes     String?
  createdAt DateTime @default(now()) @db.Timestamptz

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@index([purchaseOrderId])
  @@index([createdAt])
  @@map("supplier_payments")
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  quantity         Decimal @db.Decimal(12, 3)
  quantityReceived Decimal @default(0) @db.Decimal(12, 3)
  unitCost         Decimal @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

// =============================================================================
// EXCHANGE RATES
// =============================================================================

model ExchangeRate {
  id        String   @id @default(cuid())
  code      String   @unique // 'VES', 'COP', etc.
  rate      Decimal  @db.Decimal(18, 4)
  updatedAt DateTime @updatedAt

  @@map("exchange_rates")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  @@map("system_settings")
}

// =============================================================================
// MERMA (SPOILAGE)
// =============================================================================

model Merma {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime   @updatedAt @db.Timestamptz
  branchId      String
  productId     String
  quantity      Decimal     @db.Decimal(12, 3)
  reason        MermaReason
  description   String?
  syncStatus    SyncStatus  @default(PENDING)

  branch     Branch    @relation(fields: [branchId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])
  createdBy  User      @relation("MermaCreatedBy", fields: [createdById], references: [id])

  createdById String

  @@index([branchId, createdAt])
  @@index([productId])
  @@index([reason])
  @@index([syncStatus])
  @@map("mermas")
}

// =============================================================================
// STOCK COUNT (Physical Inventory)
// =============================================================================

model StockCount {
  id          String           @id @default(cuid())
  status      StockCountStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime         @default(now()) @db.Timestamptz
  completedAt DateTime?        @db.Timestamptz

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  syncStatus SyncStatus @default(PENDING)

  items StockCountItem[]

  @@index([branchId])
  @@index([status])
  @@index([createdById])
  @@index([syncStatus])
  @@map("stock_counts")
}

model StockCountItem {
  id            String  @id @default(cuid())
  expectedStock Decimal @db.Decimal(12, 3)
  countedStock  Decimal @db.Decimal(12, 3)
  difference    Decimal @db.Decimal(12, 3) // countedStock - expectedStock

  productId String
  product   Product @relation(fields: [productId], references: [id])

  stockCountId String
  stockCount   StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  @@unique([stockCountId, productId])
  @@index([productId])
  @@map("stock_count_items")
}

// =============================================================================
// PRODUCT BATCHES (Lots & Expiry)
// =============================================================================

model ProductBatch {
  id         String   @id @default(cuid())
  batchCode  String
  expiryDate DateTime @db.Date
  quantity   Decimal  @default(0) @db.Decimal(12, 3)
  costPrice  Decimal? @db.Decimal(12, 2)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([batchCode, productId, branchId])
  @@index([productId, branchId])
  @@index([expiryDate])
  @@map("product_batches")
}

// =============================================================================
// BANKS (F6) — Cuentas bancarias y movimientos
// El saldo NO se almacena: se calcula en tiempo real como
// saldoInicial + Σ(income) − Σ(expense).
// =============================================================================

model BankAccount {
  id             String   @id @default(cuid())
  name           String
  bankName       String?
  accountType    String   @default("checking") // 'checking' | 'savings'
  initialBalance Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.Timestamptz
  updatedAt      DateTime @updatedAt @db.Timestamptz

  transactions BankTransaction[]

  @@index([isActive])
  @@map("bank_accounts")
}

model BankTransaction {
  id        String   @id @default(cuid())
  type      String   @default("income") // 'income' | 'expense'
  amount    Decimal  @db.Decimal(12, 2)
  concept   String?
  reference String?
  createdAt DateTime @default(now()) @db.Timestamptz

  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([createdAt])
  @@map("bank_transactions")
}

// =============================================================================
// PROCESSED SYNC EVENTS (Central Idempotency Tracking)
// =============================================================================

model ProcessedSyncEvents {
  id           String   @id @default(cuid())
  eventId      String   @unique
  sourceNodeId String
  eventType    String
  processedAt  DateTime @default(now()) @db.Timestamptz

  @@index([eventId, sourceNodeId])
  @@map("processed_sync_events")
}
