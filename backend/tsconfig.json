{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "typeRoots": ["./src/types", "./node_modules/@types", "../node_modules/@types"]
    },
    "ts-node": {
        "transpileOnly": true
    },
    "include": [
        "src/**/*"
    ]
}