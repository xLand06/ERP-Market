# This file exists so `import sites/*.caddy` always matches at least one
# file (Caddy errors on a glob that matches nothing). It is intentionally
# comments only — nothing is routed.
#
# Real site files are generated by deploy/scripts/add-client.sh as
# sites/<slug>.caddy, e.g.:
#
#   myclient.erp.example.com {
#       reverse_proxy api-myclient:3000
#   }