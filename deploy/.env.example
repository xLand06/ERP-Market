# Operator configuration for the ERP-Market multi-tenant deployment kit.
# Copy to deploy/.env and edit. deploy/.env is never committed (root
# .gitignore already excludes .env).

# Base domain for automatic client URLs: <slug>.<BASE_DOMAIN>.
# Leave EMPTY to auto-derive <slug>.<VPS_IP>.sslip.io from the server's
# public IP (real Let's Encrypt HTTPS, no DNS work required).
BASE_DOMAIN=

# Let's Encrypt account email (used by Caddy ACME). REQUIRED for production
# certificate issuance.
CADDY_EMAIL=you@example.com

# Days to keep per-client database backups (scripts/backup-clients.sh).
BACKUP_KEEP_DAYS=14