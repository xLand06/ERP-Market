generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum TenantStatus {
    ACTIVE
    PROVISIONING
    ERROR
    SUSPENDED
    DELETED
}

enum PaymentStatus {
    PENDING
    PAID
    OVERDUE
    FAILED
    REFUNDED
    CANCELLED
}

model Tenant {
    id            String       @id @default(uuid())
    slug          String       @unique
    domain        String       @unique
    url           String
    status        TenantStatus @default(ACTIVE)
    // Momento exacto en que el tenant paso a SUSPENDED.
    // NO se usa updatedAt: las notificaciones/avisos escriben sobre el tenant
    // y lo renuevan cada ciclo, lo que reiniciaba el reloj de custodia (45 dias).
    suspendedAt   DateTime?
    plan          String       @default("free")
    billingCycle  String       @default("MONTHLY")  // MONTHLY | ANNUAL
    product       String       @default("market")   // ALL MARKET, ALL REPAIR, ...
    adminEmail    String?
    adminPassword String?
    dbPassword    String?
    jwtSecret     String?
    subscriptionStartedAt DateTime?
    lastPaymentAt DateTime?    // ultimo pago registrado (denormalizado para listados)
    nextPaymentDue DateTime?   // proximo vencimiento (denormalizado para listados)
    discountPercent Int        @default(0)   // 0 a 100%
    customPriceCents Int?                    // precio custom mensual si aplica
    systemNotice   String?                   // aviso o comunicado broadcast/directo
    noticeLevel    String      @default("INFO") // INFO | WARNING | DANGER
    createdAt     DateTime     @default(now())
    updatedAt     DateTime     @updatedAt
    payments      Payment[]
    healthChecks  HealthCheck[]
    auditLogs     AuditLog[]

    @@index([status])
    @@index([nextPaymentDue])
}

model Payment {
    id          String        @id @default(uuid())
    tenantId    String
    tenant      Tenant        @relation(fields: [tenantId], references: [id])
    amountCents Int
    currency    String        @default("USD")
    status      PaymentStatus @default(PENDING)
    provider    String?       // zelle | pago_movil | binance | cash | other
    billingCycle String?      // MONTHLY | ANNUAL
    periodMonths Int?         @default(1) // 1 mes o 12 meses
    externalId  String?       // referencia del pago (Zelle ref, TXID, etc.)
    paymentCode String?       @unique // codigo generado: ALLCODE-XXXX
    notes       String?
    dueDate     DateTime?     // vencimiento
    paidAt      DateTime?
    createdAt   DateTime      @default(now())

    @@index([tenantId])
    @@index([status])
    @@index([createdAt])
}

model HealthCheck {
    id          String   @id @default(uuid())
    tenantId    String
    tenant      Tenant   @relation(fields: [tenantId], references: [id])
    apiHealthy  Boolean
    dbHealthy   Boolean
    containerUp Boolean
    memoryMb    Int?
    checkedAt   DateTime @default(now())

    @@index([tenantId])
    @@index([checkedAt])
}

model AuditLog {
    id        String   @id @default(uuid())
    actor     String
    action    String
    tenantId  String?
    tenant    Tenant?  @relation(fields: [tenantId], references: [id])
    details   Json?
    createdAt DateTime @default(now())

    @@index([tenantId])
    @@index([createdAt])
    @@index([action])
}

enum RegistrationStatus {
    PENDING
    APPROVED
    REJECTED
}

model TrialRegistration {
    id           String             @id @default(uuid())
    businessName String
    ownerName    String
    taxId        String?            // RIF o Cedula de Identidad
    phone        String
    email        String
    plan         String             @default("pro")
    status       RegistrationStatus @default(PENDING)
    tenantSlug   String?
    notes        String?
    createdAt    DateTime           @default(now())
    updatedAt    DateTime           @updatedAt
}

