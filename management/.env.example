# =============================================================================
# Management Server — Environment Variables
#
# Copy to .env and fill in values before starting the stack:
#   cp .env.example .env
# =============================================================================

# ── Management API ──────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=change-me-in-production
DATABASE_URL=postgresql://mgmt:${MGMT_DB_PASSWORD}@mgmt-db:5432/mgmt
DOCKER_SOCKET=/var/run/docker.sock
NODE_ENV=production

# ── Management Database ─────────────────────────────────────────────────────
MGMT_DB_PASSWORD=change-me

# ── Caddy (deploy/caddy/) ──────────────────────────────────────────────────
CADDY_EMAIL=admin@example.com
